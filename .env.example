# Public HTTPS origin, without a path. Leave blank for non-indexable previews.
NEXT_PUBLIC_SITE_URL=
# Optional: leave all three blank to use direct email instead of form delivery.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Enable only behind a proxy that overwrites X-Forwarded-For.
CONTACT_TRUST_PROXY=false
